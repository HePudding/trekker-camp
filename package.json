{
	"name": "trekker-camp",
	"version": "2026.11.0",
	"codename": "nasubi",
	"repository": {
		"type": "git",
		"url": "https://github.com/HePudding/trekker-camp.git"
	},
	"packageManager": "pnpm@12.17.0",
	"workspaces": [
		"apps/*",
		"packages/*",
		"apps/misskey/packages/backend",
		"apps/misskey/packages/frontend-shared",
		"apps/misskey/packages/frontend",
		"apps/misskey/packages/frontend-builder",
		"apps/misskey/packages/frontend-embed",
		"apps/misskey/packages/i18n",
		"apps/misskey/packages/icons-subsetter",
		"apps/misskey/packages/sw",
		"apps/misskey/packages/misskey-js",
		"apps/misskey/packages/misskey-js/generator",
		"apps/misskey/packages/misskey-reversi",
		"apps/misskey/packages/misskey-bubble-game",
		"apps/misskey/packages-private/*"
	],
	"private": true,
	"scripts": {
		"build-pre": "pnpm --dir apps/misskey run build-pre",
		"build-assets": "pnpm --dir apps/misskey run build-assets",
		"build": "pnpm --dir apps/misskey run build",
		"build-storybook": "pnpm --dir apps/misskey run build-storybook",
		"build-misskey-js-with-types": "pnpm --dir apps/misskey run build-misskey-js-with-types",
		"start": "node apps/misskey/scripts/start.mjs",
		"start:inspect": "pnpm --dir apps/misskey run start:inspect",
		"start:test": "pnpm --dir apps/misskey run start:test",
		"cli": "pnpm --dir apps/misskey run cli",
		"init": "pnpm --dir apps/misskey run init",
		"migrate": "pnpm --dir apps/misskey run migrate",
		"revert": "pnpm --dir apps/misskey run revert",
		"check:connect": "pnpm --dir apps/misskey run check:connect",
		"migrateandstart": "node apps/misskey/scripts/start.mjs --migrate",
		"watch": "pnpm --dir apps/misskey run watch",
		"dev": "pnpm --dir apps/misskey run dev",
		"assets:link": "node scripts/private-assets.mjs",
		"assets:pull": "node scripts/pull-private-assets.mjs",
		"assets:check": "node scripts/check-private-assets.mjs",
		"assets:test": "node --test scripts/private-assets.test.mjs scripts/pull-private-assets.test.mjs",
		"check-dts": "node scripts/check-dts.mjs",
		"lint": "pnpm --dir apps/misskey run lint",
		"e2e": "pnpm --dir apps/misskey run e2e",
		"e2e-dev-container": "pnpm --dir apps/misskey run e2e-dev-container",
		"backend-unit-test": "pnpm --dir apps/misskey run backend-unit-test",
		"backend-unit-test-and-coverage": "pnpm --dir apps/misskey run backend-unit-test-and-coverage",
		"test": "pnpm --dir apps/misskey run test",
		"test-and-coverage": "pnpm --dir apps/misskey run test-and-coverage",
		"clean": "pnpm --dir apps/misskey run clean",
		"clean-all": "pnpm --dir apps/misskey run clean-all",
		"cleanall": "pnpm --dir apps/misskey run cleanall",
		"build:all": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" --if-present build",
		"check:shipping": "node scripts/check-shipping.mjs"
	},
	"dependencies": {
		"esbuild": "0.28.2",
		"execa": "10.2.1",
		"ignore-walk": "9.0.0",
		"js-yaml": "5.5.0",
		"tar": "7.5.22"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@misskey-dev/eslint-plugin": "2.1.0",
		"@types/node": "26.6.6",
		"@typescript-eslint/eslint-plugin": "8.72.1",
		"@typescript-eslint/parser": "8.72.1",
		"@typescript/native": "npm:typescript@7.0.2",
		"cross-env": "10.1.0",
		"eslint": "9.39.5",
		"globals": "17.14.0",
		"ncp": "2.0.0",
		"start-server-and-test": "3.0.13",
		"typescript": "npm:@typescript/typescript6@6.0.2"
	}
}
